app ForLoops {
    for i in 0..3 {
        say "i={i}"
    }
    for i in 5..5 {
        say "never"
    }
    var total = 0
    for n in [1, 2, 3, 4, 5, 6] {
        if n % 2 == 0 {
            continue
        }
        if n > 4 {
            break
        }
        total = total + n
    }
    say total
    // nested loops with break/continue in the inner loop
    for a in 1..4 {
        for b in 1..4 {
            if b == a {
                continue
            }
            if b > 2 {
                break
            }
            say "{a}{b}"
        }
    }
    // modifying the array inside the loop does not change the iteration
    var xs = [1, 2]
    for x in xs {
        xs.push(x * 10)
    }
    say xs
}
