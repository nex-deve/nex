fn first_even(xs: [Int]) -> Int {
    for x in xs {
        try {
            if x % 2 == 0 {
                return x
            }
        } catch e {
            return -1
        }
    }
    fail "no even number"
}

app Main {
    say first_even([1, 3, 8, 5])
    // the handler inside first_even must not catch this later failure
    try {
        say first_even([1, 3])
    } catch e {
        say "caught: {e}"
    }
}
