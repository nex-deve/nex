fn fact(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

fn greet(name: Str) {
    if name == "" {
        say "nobody"
        return
    }
    say "hi {name}"
}

fn is_even(n: Int) -> Bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

fn is_odd(n: Int) -> Bool {
    if n == 0 { return false }
    return is_even(n - 1)
}

fn pick(flag: Bool) -> Str {
    if flag { return "yes" } else { return "no" }
}

app Functions {
    say fact(20)
    greet("NEX")
    greet("")
    say is_even(10)
    say is_odd(7)
    say pick(false)
}
