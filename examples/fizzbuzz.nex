// FizzBuzz from 1 to 15.
fn label(n: Int) -> Str {
    if n % 15 == 0 {
        return "FizzBuzz"
    } else if n % 3 == 0 {
        return "Fizz"
    } else if n % 5 == 0 {
        return "Buzz"
    }
    return "{n}"
}

app FizzBuzz {
    var i = 1
    while i <= 15 {
        say label(i)
        i = i + 1
    }
}
