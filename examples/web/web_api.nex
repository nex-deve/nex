// A tiny JSON web API. Run it, then open http://127.0.0.1:8080/hello?name=NEX
// (it stops after 3 requests so it can be used in examples and tests;
// use `while true` for a real server).
app WebApi {
    let server = http_listen(8080)
    say "listening on http://127.0.0.1:{http_port(server)}"
    var served = 0
    while served < 3 {
        let req = http_accept(server)
        served = served + 1
        if req["path"] == "/hello" {
            let reply = {"message": json("Hello!"), "query": json(req["query"])}
            http_respond(req["id"], 200, "application/json", to_json(reply))
        } else {
            http_respond(req["id"], 404, "text/plain", "not found")
        }
    }
}
