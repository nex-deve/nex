// Recursive and iterative Fibonacci.
fn fib(n: Int) -> Int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn fib_fast(n: Int) -> Int {
    var a = 0
    var b = 1
    var i = 0
    while i < n {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    return a
}

app Fibonacci {
    say "fib(20) = {fib(20)}"
    say "fib(90) = {fib_fast(90)}"
}
